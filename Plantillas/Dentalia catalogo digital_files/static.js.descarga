 scriptList = [\n            'https://unpkg.com/@lottiefiles/dotlottie-wc@0.8.1/dist/dotlottie-wc.js',\n        ];\n\n        scriptList.forEach(function(a) {\n            let script = document.createElement('script');\n            script.src = a;\n            script.async = false;\n            $('head').append(script);\n        });\n\n    });\n    // --- End of Script Loading ---\n\n    // --- Property and Data Setup ---\n    let playerHTML = \"<div>Please insert your Lottie animation URL.</div>\";\n    \n   \n // --- Start of Property and Data Setup ---\n    const { bubble, ...rest } = properties;\n    instance.data = rest;\n\n    let {\n        animation_url,\n        controls,\n        loop,\n        speed,\n        autoplay,\n        background,\n        mode,\n    } = instance.data;\n    // --- End of Property and Data Setup ---\n\n    // --- Start of Helper Functions ---\n    function uuid() {\n        return ([1e7] + -1e3 + -4e3 + -8e3 + -1e11).replace(/[018]/g, c =>\n            (c ^ crypto.getRandomValues(new Uint8Array(1))[0] & 15 >> c / 4).toString(16)\n        );\n    }\n\n    function rgbaToHexA(rgba) {\n        if (!rgba || typeof rgba !== 'string') return 'transparent';\n        if (/^#([0-9A-F]{6}|[0-9A-F]{8})$/i.test(rgba)) return rgba;\n        const match = rgba.match(/rgba?\\((\\d+),\\s*(\\d+),\\s*(\\d+)(?:,\\s*([\\d.]+))?\\)/);\n        if (!match) return 'transparent';\n        const r = parseInt(match[1], 10).toString(16).padStart(2, '0');\n        const g = parseInt(match[2], 10).toString(16).padStart(2, '0');\n        const b = parseInt(match[3], 10).toString(16).padStart(2, '0');\n        const alpha = match[4] !== undefined ? parseFloat(match[4]) : 1;\n        const a = Math.round(alpha * 255).toString(16).padStart(2, '0');\n        return `#${r}${g}${b}${a}`;\n    }\n    // --- End of Helper Functions ---\n\n    if (animation_url) {\n        const elementID = `dotlottie_${uuid()}`;\n        const isAutoplayEnabled = (mode === \"Page Load\") ? autoplay : false;\n        const hexBackground = rgbaToHexA(background);\n\n        // --- Start of HTML and CSS Generation ---\n        const playerHTML = `\n            <dotlottie-wc\n                class=\"lottie-player-instance\"\n                id=\"${elementID}\"\n                src=\"${animation_url}\"\n                speed=\"${speed}\"\n                style=\"width: 100%; display: block;\"\n                ${loop ? \"loop\" : \"\"}\n                ${isAutoplayEnabled ? \"autoplay\" : \"\"}\n            ></dotlottie-wc>\n        `;\n\n        const ICONS = {\n            play: '<svg width=\"24\" height=\"24\" viewBox=\"0 0 16 16\"><path d=\"M3.333 3.468c0-.945 1.026-1.533 1.84-.956l7.722 4.532c.805.472.805 1.64 0 2.112L5.174 13.586c-.814.577-1.84-.01-1.84-.956V3.468z\" fill=\"#20272C\"/></svg>',\n            pause: '<svg width=\"24\" height=\"24\" viewBox=\"0 0 16 16\"><path d=\"M3 2c-.552 0-1 .448-1 1v10c0 .552.448 1 1 1h2c.552 0 1-.448 1-1V3c0-.552-.448-1-1-1H3zm7 0c-.552 0-1 .448-1 1v10c0 .552.448 1 1 1h2c.552 0 1-.448 1-1V3c0-.552-.448-1-1-1h-2z\" fill=\"#20272C\"/></svg>',\n            stop: '<svg width=\"24\" height=\"24\" viewBox=\"0 0 16 16\"><path d=\"M3 3h10v10H3z\" fill=\"#20272C\"/></svg>',\n            loop: '<svg width=\"24\" height=\"24\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M10.865 2.313c.196-.195.512-.195.708 0l1.885 1.886c.196.195.196.512 0 .707l-1.886 1.886c-.195.195-.512.195-.707 0-.195-.195-.195-.512 0-.707L11.616 5.333H4v1.334c0 .368-.299.666-.667.666A.667.667 0 0 1 2.667 6.667V4.667c0-.368.299-.667.667-.667h8.512l-.98-.98c-.195-.196-.195-.512 0-.708zM12.438 12c.368 0 .666-.299.666-.667V9.333c0-.368-.298-.667-.666-.667-.368 0-.667.299-.667.667v1.334H4.155l.75-.75a.471.471 0 0 0 0-.667.471.471 0 0 0-.667 0l-1.885 1.886a.47.47 0 0 0 0 .666l1.886 1.886a.471.471 0 0 0 .667 0 .471.471 0 0 0 0-.667l-.98-.98H12.438z\" fill=\"currentColor\"/></svg>'\n        };\n        \n        // MODIFIED: Swapped IDs for classes to ensure uniqueness per instance\n        const controlsHTML = `\n            <div class=\"toolbar\">\n                <button class=\"lottie-play-pause-btn\">${ICONS.play}</button>\n                <button class=\"lottie-stop-btn\">${ICONS.stop}</button>\n                <input class=\"lottie-seeker-input seeker\" type=\"range\" min=\"0\" max=\"100\" step=\"0.1\" value=\"0\" style=\"--seeker: 0;\">\n                <button class=\"lottie-loop-toggle\">${ICONS.loop}</button>\n            </div>\n        `;\n\n        const controlsCSS = `\n            <style>\n                .lottie-container { display: flex; flex-direction: column; width: 100%; height: 100%; overflow: hidden; --lottie-player-toolbar-height: 45px; --lottie-player-toolbar-icon-active-color: #00ddb3; --lottie-player-seeker-accent-color: #00c1a2; --lottie-player-seeker-thumb-color: #00c1a2; }\n                .animation { min-height: 0; width: 100%; }\n                .toolbar { display: flex; align-items: center; justify-content: center; width: 100%; height: var(--lottie-player-toolbar-height); flex-shrink: 0; }\n                .toolbar button { cursor: pointer; background: none; border: 0; border-radius: 4px; padding: 4px; display: flex; align-items: center; justify-content: center; margin: 0 2px; width: 24px; height: 24px; }\n                .toolbar button:hover { background-color: #f3f8f8; }\n                .toolbar button.active { color: var(--lottie-player-toolbar-icon-active-color) !important; }\n                .toolbar button svg { width: 24px; height: 24px; fill: #20272C; }\n                .toolbar button.active svg { fill: var(--lottie-player-toolbar-icon-active-color); }\n                .seeker { -webkit-appearance: none; appearance: none; height: 6px; width: 100%; max-width: 250px; margin: 0 8px; border-radius: 9999px; cursor: pointer; background-image: linear-gradient(to right, var(--lottie-player-seeker-accent-color) calc(var(--seeker) * 1%), #d9e0e6 calc(var(--seeker) * 1%)); }\n                .seeker::-webkit-slider-thumb { -webkit-appearance: none; height: 16px; width: 16px; border-radius: 50%; background: var(--lottie-player-seeker-thumb-color); cursor: pointer; margin-top: 0px; }\n                .seeker::-moz-range-thumb { height: 16px; width: 16px; border-radius: 50%; background: var(--lottie-player-seeker-thumb-color); cursor: pointer; border: none; margin-top: 0px; }\n            </style>\n        `;\n\n        const finalHTML = `\n            <div class=\"lottie-container\">\n                <div class=\"animation\">${playerHTML}</div>\n                ${controls ? controlsHTML : \"\"}\n                ${controls ? controlsCSS : \"\"}\n            </div>`;\n            \n        instance.canvas.html(finalHTML);\n        \n        const playerElement = document.getElementById(elementID);\n\n        const myInterval = setInterval(() => {\n            if (playerElement && playerElement.dotLottie) {\n                const dotLottie = playerElement.dotLottie;\n                clearInterval(myInterval);\n\n                if (background) dotLottie.setBackgroundColor(hexBackground);\n                if (controls) setupPlayerControls(playerElement, dotLottie);\n                if (mode !== \"Page Load\") setupInteractivity(playerElement, dotLottie);\n            }\n        }, 100);\n\n        function setupPlayerControls(player, lottie) {\n            // MODIFIED: Find elements by class within this specific instance's canvas\n            const container = instance.canvas[0];\n            const playBtn = container.querySelector('.lottie-play-pause-btn');\n            const stopBtn = container.querySelector('.lottie-stop-btn');\n            const seeker = container.querySelector('.lottie-seeker-input');\n            const loopBtn = container.querySelector('.lottie-loop-toggle');\n\n            if (!playBtn || !stopBtn || !seeker || !loopBtn) return;\n\n            let animationFrameId = null;\n\n            const syncSeeker = () => {\n                if (lottie.totalFrames > 0) {\n                    const progress = (lottie.currentFrame / lottie.totalFrames) * 100;\n                    if (!lottie.isSeeking) seeker.value = progress;\n                    seeker.style.setProperty('--seeker', progress);\n                }\n                animationFrameId = requestAnimationFrame(syncSeeker);\n            };\n            \n            const stopSyncSeeker = () => {\n                if (animationFrameId) {\n                    cancelAnimationFrame(animationFrameId);\n                    animationFrameId = null;\n                }\n            };\n\n            loopBtn.classList.toggle('active', lottie.loop);\n            playBtn.innerHTML = lottie.isPlaying ? ICONS.pause : ICONS.play;\n            if (lottie.isPlaying) requestAnimationFrame(syncSeeker);\n\n            playBtn.addEventListener('click', () => {\n                if (lottie.isPlaying) lottie.pause();\n                else lottie.play();\n            });\n\n            stopBtn.addEventListener('click', () => lottie.stop());\n            \n            loopBtn.addEventListener('click', () => {\n                const wasPlaying = lottie.isPlaying;\n                lottie.setLoop(!lottie.loop);\n                loopBtn.classList.toggle('active', lottie.loop);\n                if (wasPlaying) lottie.play();\n            });\n\n            seeker.addEventListener('input', () => {\n                const frame = (seeker.value / seeker.max) * lottie.totalFrames;\n                lottie.setFrame(frame);\n                seeker.style.setProperty('--seeker', seeker.value);\n            });\n            seeker.addEventListener('mousedown', () => lottie.freeze());\n            seeker.addEventListener('mouseup', () => lottie.unfreeze());\n            \n            lottie.addEventListener('play', () => {\n                playBtn.innerHTML = ICONS.pause;\n                stopSyncSeeker();\n                animationFrameId = requestAnimationFrame(syncSeeker);\n            });\n\n            const onStopOrPause = () => {\n                playBtn.innerHTML = ICONS.play;\n                stopSyncSeeker();\n            };\n            lottie.addEventListener('pause', onStopOrPause);\n            lottie.addEventListener('stop', onStopOrPause);\n            \n            lottie.addEventListener('complete', () => {\n                if (!lottie.loop) {\n                    playBtn.innerHTML = ICONS.play;\n                    stopSyncSeeker();\n                }\n                seeker.value = 100;\n                seeker.style.setProperty('--seeker', 100);\n            });\n        }\n        \n        function setupInteractivity(player, lottie) {\n             switch (mode) {\n                case \"Click\":\n                    player.addEventListener('click', (e) => {\n                        if (e.target.closest('.toolbar')) return;\n                        if (lottie.isPlaying) lottie.pause();\n                        else {\n                            if (lottie.currentFrame >= lottie.totalFrames - 1) lottie.setFrame(0);\n                            lottie.play();\n                        }\n                    });\n                    break;\n                case \"Hover\":\n                    player.addEventListener('mouseenter', () => {\n                        if (lottie.currentFrame >= lottie.totalFrames - 1) lottie.setFrame(0);\n                        lottie.play();\n                    });\n                    player.addEventListener('mouseleave', () => lottie.pause());\n                    break;\n            }\n        }\n    } else {\n        instance.canvas.html(playerHTML);\n    }\n}\n\n"},"initialize":{"fn":"function(n,t){const _0x474242=['MTY3NjI4MDU3MzYxNHg4OTE2Nzc4NDIyMDYwOTc0MDA='];{}}"},"update":{"fn":"function(e,t,n){const _0x474242=['MTY3NjI4MDU3MzYxNHg4OTE2Nzc4NDIyMDYwOTc0MDA='];const _0x5d7e97=_0x1cf2;(function(_0x1d92b6,_0x30920b){const _0x47a7d2={_0x1d8ff6:0x109,_0x51f906:0x107,_0x25900e:0x10a},_0x593aa9=