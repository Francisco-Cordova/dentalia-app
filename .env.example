# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
VITE_APP_NAME=Dentalia

# Session
SESSION_DRIVER=cookie

# Mail (Mailtrap sandbox: https://mailtrap.io → Email Testing → Inbox → Integrations → SMTP)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@dentalia.local

# Supabase (PostgreSQL)
# Connection string del proyecto: Supabase → Settings → Database → Connection string
SUPABASE_DB_URL=